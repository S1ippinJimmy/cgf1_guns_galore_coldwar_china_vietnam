<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="CGF1_MWP_Pistol_Compact_T1">
		<defName>CGF1_MWP_Type77_Pistol_</defName>
		<label>Type 77 Pistol</label>
		<description>Caliber: 7.62x17mm Rimless. 7-round detachable mag. Semi-Automatic.
	
The Type 77 is a Chinese compact pistol designed in the 1970s as a replacement for the Type 64, firing the same 7.62x17mm Rimless cartridge as used in that pistol. Like its predecessor, the Type 77 was meant to be used for military and police officers as a self-defense weapon, and proved to be particularly popular in this role; while it was eventually replaced by the QSZ-92 in military service, the pistol continues to be found across China. The Type 77 was also adapted for export, and several variants of it are sold abroad even in the present.</description>
		<graphicData>
			<texPath>CGF1/Gun/Type77_Pistol</texPath>
			<drawSize>0.90</drawSize>
		</graphicData>
		<uiIconScale>1.4</uiIconScale>
		<recipeMaker>
			<recipeUsers>
				<li>CGF1_MWP_Building_Gunsmith</li>
			</recipeUsers>
			<researchPrerequisite>CGF1_MWP_Research_T9_SpaceAgeFirearms</researchPrerequisite>
			<skillRequirements>
				<Crafting>4</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<Steel>20</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToMake>5000</WorkToMake>
			<Mass>0.7</Mass>
			<AccuracyTouch>0.85</AccuracyTouch>
			<AccuracyShort>0.65</AccuracyShort>
			<AccuracyMedium>0.35</AccuracyMedium>
			<AccuracyLong>0.30</AccuracyLong>
			<RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
		</statBases>
		<weaponTags>
			<li>CGF1_Pistol_Civilian</li>
			<li>CGF1_Pistol_Military</li>
		</weaponTags>
		<weaponClasses>
			<li>RangedLight</li>
		</weaponClasses>
		<tradeTags>
			<li>CGF1_GunsGalore_ColdWarChinaVietnam</li>
			<li>CGF1_GunsGalore_ColdWarChinaVietnam_Pistol</li>
		</tradeTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CGF1_MWP_Bullet_762x17mmRimless_Pistol</defaultProjectile>
				<warmupTime>0.15</warmupTime>
				<range>25.9</range>
				<soundCast>CGF1_GG_SFXR_Pistol4</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
				<def>MF_StandardMuzzleFalshTwo</def>
				<drawSize>(0.8,0.8)</drawSize>
				<offsets>
					<li>(0.20,0.15)</li>
				</offsets>
			</li>
		</modExtensions>
		<generateCommonality>0.10</generateCommonality> <!-- Average -->
	</ThingDef>
	
