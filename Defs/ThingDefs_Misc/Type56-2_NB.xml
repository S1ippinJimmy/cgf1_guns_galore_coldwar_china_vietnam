<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="CGF1_MWP_AssaultRifle_T1">
		<defName>CGF1_MWP_Type56_2_NB_</defName>
		<label>Type 56-2 NB</label>
		<description>Caliber: 7.62x39mm. 30-round detachable mag. Select-Fire.
		
The Type 56 is a Chinese copy of the Soviet Avtomat Kalashnikov (AK) rifle. Though almost a 1:1 copy of the Type III AK, the Type 56 has some notable differences - notably, most are found with stamped (like on the AKM) rather than milled receivers, and the Type 56 has a distinctive enclosed hooded front sight. Type 56 rifles also often feature their own integral folding bayonets (though this rifle does not have one, instead using a typical AKM-style bayonet.) Chinese AKs are among the most common in the world today, Type 56 rifles in their original configuration are still produced.

This variant is a Type 56-2, first produced in 1980, which features a side-folding stock and was primarily designed for export.</description>
		<graphicData>
			<texPath>CGF1/Gun/Type56-2_NB</texPath>
			<drawSize>1.01</drawSize>
		</graphicData>
		<recipeMaker>
			<recipeUsers>
				<li>CGF1_MWP_Building_Gunsmith</li>
			</recipeUsers>
			<researchPrerequisite>CGF1_MWP_Research_T8_AtomicAgeFirearms</researchPrerequisite>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<Steel>60</Steel>
			<ComponentIndustrial>7</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToMake>40000</WorkToMake>
			<Mass>3.6</Mass>
			<AccuracyTouch>0.60</AccuracyTouch>
			<AccuracyShort>0.60</AccuracyShort>
			<AccuracyMedium>0.55</AccuracyMedium>
			<AccuracyLong>0.50</AccuracyLong>
			<RangedWeapon_Cooldown>1.7</RangedWeapon_Cooldown>
		</statBases>
		<equippedAngleOffset>40</equippedAngleOffset>
		<weaponTags>
			<li>CGF1_AR_Civilian</li>
			<li>CGF1_AR_Military</li>
		</weaponTags>
		<tradeTags>
			<li>CGF1_GunsGalore_ColdWarChinaVietnam</li>
			<li>CGF1_GunsGalore_ColdWarChinaVietnam_AR</li>
		</tradeTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CGF1_MWP_Bullet_762x39mm_Auto</defaultProjectile>
				<warmupTime>1</warmupTime>
				<range>30.9</range>
				<burstShotCount>4</burstShotCount>
				<ticksBetweenBurstShots>8</ticksBetweenBurstShots>
				<soundCast>CGF1_GG_SFXR_Rifle2</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.8,0.8)</drawSize>
				<offsets>
					<li>(0.5,0.03)</li>
				</offsets>
			</li>
		</modExtensions>
		<generateCommonality>0.20</generateCommonality> <!-- Common -->
	</ThingDef>
	
