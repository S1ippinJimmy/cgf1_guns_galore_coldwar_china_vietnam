<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="CGF1_MWP_AssaultRifle_T0">
		<defName>CGF1_MWP_Type87_</defName>
		<label>Type 87</label>
		<description>Caliber: 5.8x42mm. 30-round detachable mag. Select-Fire.
		
The Type 87 is a development of the Chinese Type 81 assault rifle used to test out the 5.8x42mm round. While it was considered for adoption to replace the Type 81, it ultimately did not enter mainline service, though there is some evidence that the Type 87s that were produced saw use by special PLA military units for a time. While it would ultimately remain an obscure weapon, the Type 87 continued to be developed into the 1990s, with several variants being produced - ultimately, in the 2000s, the QBZ-03 rifle would emerge as a product of this development, and would be adopted for limited service.</description>
		<graphicData>
			<texPath>CGF1/Gun/Type87</texPath>
			<drawSize>1.00</drawSize>
		</graphicData>
		<recipeMaker>
			<recipeUsers>
				<li>CGF1_MWP_Building_Gunsmith</li>
			</recipeUsers>
			<researchPrerequisite>CGF1_MWP_Research_T9_SpaceAgeFirearms</researchPrerequisite>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<Steel>60</Steel>
			<ComponentIndustrial>7</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToMake>40000</WorkToMake>
			<Mass>3.6</Mass>
			<AccuracyTouch>0.60</AccuracyTouch>
			<AccuracyShort>0.70</AccuracyShort>
			<AccuracyMedium>0.65</AccuracyMedium>
			<AccuracyLong>0.55</AccuracyLong>
			<RangedWeapon_Cooldown>1.7</RangedWeapon_Cooldown>
		</statBases>
		<equippedAngleOffset>40</equippedAngleOffset>
		<weaponTags>
			<li>CGF1_AR_Military</li>
			<li>CGF1_AR_Military_Advanced</li>
		</weaponTags>
		<tradeTags>
			<li>CGF1_GunsGalore_ColdWarChinaVietnam</li>
			<li>CGF1_GunsGalore_ColdWarChinaVietnam_AR</li>
		</tradeTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CGF1_MWP_Bullet_58x42mmDBP10_Auto</defaultProjectile>
				<warmupTime>1</warmupTime>
				<range>30.9</range>
				<burstShotCount>4</burstShotCount>
				<ticksBetweenBurstShots>7</ticksBetweenBurstShots>
				<soundCast>CGF1_GG_SFXR_Rifle3</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.7,0.7)</drawSize>
				<offsets>
					<li>(0.55,0.06)</li>
				</offsets>
			</li>
		</modExtensions>
		<generateCommonality>0.05</generateCommonality> <!-- Uncommon -->
		<thingSetMakerTags>
			<li>CGF1_GunsGalore_RewardAncient_Common</li>
		</thingSetMakerTags>
	</ThingDef>
	
